+static EGLDisplay get_gdk_egl_display(GdkDisplay* display) {
+  const auto get_platform_display =
+      reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(
+          eglGetProcAddress("eglGetPlatformDisplayEXT"));
+  if (GDK_IS_WAYLAND_DISPLAY(display)) {
+    EGLNativeDisplayType native_display =
+        (EGLNativeDisplayType)gdk_wayland_display_get_wl_display(display);
+    if (get_platform_display != nullptr) {
+      EGLDisplay egl_display = get_platform_display(
+          EGL_PLATFORM_WAYLAND_EXT, native_display, nullptr);
+      if (egl_display != EGL_NO_DISPLAY) {
+        return egl_display;
+      }
+    }
+    return eglGetDisplay(native_display);
+  }
+  if (GDK_IS_X11_DISPLAY(display)) {
+    EGLNativeDisplayType native_display =
+        (EGLNativeDisplayType)gdk_x11_display_get_xdisplay(display);
+    if (get_platform_display != nullptr) {
+      EGLDisplay egl_display = get_platform_display(
+          EGL_PLATFORM_X11_EXT, native_display, nullptr);
+      if (egl_display != EGL_NO_DISPLAY) {
+        return egl_display;
+      }
+    }
+    return eglGetDisplay(native_display);
+  }
+  return EGL_NO_DISPLAY;
+}
