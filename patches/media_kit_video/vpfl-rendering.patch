diff --git a/linux/video_output_manager.cc b/linux/video_output_manager.cc
index 281e407..aac6bd6 100644
--- a/linux/video_output_manager.cc
+++ b/linux/video_output_manager.cc
@@ -73,3 +73,13 @@ void video_output_manager_dispose(VideoOutputManager* self, gint64 handle) {
